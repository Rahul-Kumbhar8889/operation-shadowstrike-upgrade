# Public backend URL (not a secret). Vite embeds it at build time.
# .env.production already sets this URL for npm run build.
# Leave this unset for npm run dev to use the local Vite proxy and Node server.
# To use Render during development, copy this file to .env.local and restart Vite.
VITE_SOCKET_SERVER_URL=https://operation-shadowstrike-upgrade.onrender.com
